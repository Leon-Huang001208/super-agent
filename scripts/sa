#!/bin/sh
set -eu
set -o pipefail
umask 077
sa_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
sa_volume=/Volumes/SuperAgentDockerData
sa_data_root=$sa_volume/paperclip-v2026.1023.0
sa_action=${1:-status}
case "$sa_action" in up|status|stop|test|preflight|logs|image-build|image-audit) ;; *) printf '%s\n' '{"errorCode":"ACTION_NOT_ALLOWED"}' >&2; exit 64;; esac
if [ ! -d "$sa_data_root" ]; then printf '%s\n' '{"errorCode":"DEDICATED_STORAGE_NOT_MOUNTED"}' >&2; exit 1; fi
sa_fs=$(/usr/sbin/diskutil info -plist "$sa_volume" | /usr/bin/plutil -extract FilesystemType raw -o - -)
if [ "$sa_fs" != apfs ]; then printf '%s\n' '{"errorCode":"APFS_STORAGE_REQUIRED"}' >&2; exit 1; fi
sa_mount=$(/usr/sbin/diskutil info -plist "$sa_volume" | /usr/bin/plutil -extract MountPoint raw -o - -)
if [ "$sa_mount" != "$sa_volume" ]; then printf '%s\n' '{"errorCode":"DEDICATED_STORAGE_NOT_MOUNTED"}' >&2; exit 1; fi
cd "$sa_root"
export SUPER_AGENT_DATA_ROOT=$sa_data_root
sa_log=$sa_data_root/logs/driver.jsonl
printf '{"at":"%s","action":"%s","status":"started"}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$sa_action" >>"$sa_log"
trap 'sa_exit=$?; printf "{\"action\":\"%s\",\"exitCode\":%s}\n" "$sa_action" "$sa_exit" >>"$sa_log"' EXIT
sa_compose() {
  docker compose --file "$sa_root/compose.yaml" --project-name super-agent-paperclip-eval --env-file /dev/null "$@"
}
case "$sa_action" in
  image-build) node scripts/runtime-image.mjs build ;;
  image-audit) node scripts/runtime-image.mjs audit ;;
  up)
    SUPER_AGENT_RUNTIME_IMAGE=$(node scripts/runtime-image.mjs resolve)
    export SUPER_AGENT_RUNTIME_IMAGE
    sa_compose config --quiet
    sa_compose up --no-build --pull never -d gateway
    ;;
  status) SUPER_AGENT_RUNTIME_IMAGE=super-agent-paperclip-runtime:2026.1023.0-arm64 sa_compose ps --all ;;
  stop) SUPER_AGENT_RUNTIME_IMAGE=super-agent-paperclip-runtime:2026.1023.0-arm64 sa_compose stop gateway paperclip db prepare bootstrap ;;
  test) SUPER_AGENT_RUNTIME_IMAGE=super-agent-paperclip-runtime:2026.1023.0-arm64 sa_compose --profile tools run --rm --no-deps tools npm test ;;
  preflight) SUPER_AGENT_RUNTIME_IMAGE=super-agent-paperclip-runtime:2026.1023.0-arm64 sa_compose --profile tools run --rm --no-deps tools npm run preflight ;;
  logs)
    export SUPER_AGENT_RUNTIME_IMAGE=super-agent-paperclip-runtime:2026.1023.0-arm64
    sa_log_file=$(mktemp "$sa_data_root/logs/container-logs.XXXXXX")
    sa_compose logs --no-color --tail 300 gateway paperclip db | sa_compose --profile tools run --rm --no-deps -T tools node scripts/redact-logs.mjs >"$sa_log_file"
    printf '{"status":"saved-redacted","log":"%s"}\n' "$sa_log_file"
    ;;
esac
