#!/bin/sh
set -eu
set -o pipefail
umask 077
sa_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
sa_volume=/Volumes/SuperAgentDockerData
sa_data_root=$sa_volume/paperclip-v2026.1023.0
sa_action=${1:-status}
case "$sa_action" in up|status|stop|test|preflight|logs) ;; *) printf '%s\n' '{"errorCode":"ACTION_NOT_ALLOWED"}' >&2; exit 64;; esac
if [ ! -d "$sa_data_root" ]; then printf '%s\n' '{"errorCode":"DEDICATED_STORAGE_NOT_MOUNTED"}' >&2; exit 1; fi
sa_fs=$(/usr/sbin/diskutil info -plist "$sa_volume" | /usr/bin/plutil -extract FilesystemType raw -o - -)
if [ "$sa_fs" != apfs ]; then printf '%s\n' '{"errorCode":"APFS_STORAGE_REQUIRED"}' >&2; exit 1; fi
sa_mount=$(/usr/sbin/diskutil info -plist "$sa_volume" | /usr/bin/plutil -extract MountPoint raw -o - -)
if [ "$sa_mount" != "$sa_volume" ]; then printf '%s\n' '{"errorCode":"DEDICATED_STORAGE_NOT_MOUNTED"}' >&2; exit 1; fi
cd "$sa_root"
export SUPER_AGENT_DATA_ROOT=$sa_data_root
sa_log=$sa_data_root/logs/driver.jsonl
printf '{"at":"%s","action":"%s","status":"started"}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$sa_action" >>"$sa_log"
trap 'sa_exit=$?; printf "{\"action\":\"%s\",\"exitCode\":%s}\n" "$sa_action" "$sa_exit" >>"$sa_log"' EXIT
case "$sa_action" in
  up) docker compose config --quiet; docker compose up -d gateway ;;
  status) docker compose ps --all ;;
  stop) docker compose stop gateway paperclip db prepare bootstrap ;;
  test) docker compose --profile tools run --rm tools npm test ;;
  preflight) docker compose --profile tools run --rm tools npm run preflight ;;
  logs)
    sa_log_file=$(mktemp "$sa_data_root/logs/container-logs.XXXXXX")
    docker compose logs --no-color --tail 300 gateway paperclip db | docker compose --profile tools run --rm -T tools node scripts/redact-logs.mjs >"$sa_log_file"
    printf '{"status":"saved-redacted","log":"%s"}\n' "$sa_log_file"
    ;;
esac
