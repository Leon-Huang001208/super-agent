FROM node@sha256:a52166d89cfcc66ea62d10535ca712d161cece5d77ff4cfa758866b6b75ccb3f
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git openssh-client python3 tini \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/paperclip
COPY docker/entrypoint.sh docker/bootstrap.mjs docker/serve.mjs docker/server-entry.mjs docker/chief-web-app-hook.mjs docker/complete-lock.mjs docker/verify-install.mjs docker/codex-hello-gate.mjs docker/codex-chief-web-gate.mjs docker/package.install.json docker/package-lock.install.json /opt/super-agent/
COPY docker/bin /opt/super-agent/bin
COPY bridge/chief-web-call-admission.mjs \
     bridge/chief-web-evaluation.mjs \
     bridge/chief-web-intent-authority.mjs \
     bridge/chief-web-intent-consumer.mjs \
     bridge/chief-web-native-store.mjs \
     bridge/chief-web-paperclip-repository.mjs \
     bridge/chief-web-paperclip.mjs \
     bridge/chief-web-pilot.mjs \
     bridge/chief-web-private-file.mjs \
     bridge/chief-web-projection.mjs \
     bridge/chief-web-recovery-cli.mjs \
     bridge/chief-web-recovery-entry.mjs \
     bridge/chief-web-recovery-finalization.mjs \
     bridge/chief-web-recovery-io.mjs \
     bridge/chief-web-recovery-lease.mjs \
     bridge/chief-web-recovery-native.mjs \
     bridge/chief-web-recovery-publisher.mjs \
     bridge/chief-web-recovery.mjs \
     bridge/chief-web-routes.mjs \
     bridge/chief-web-runtime-bootstrap.mjs \
     bridge/chief-web-settlement.mjs \
     bridge/chief-web-skipped-wake.mjs \
     bridge/chief-web-supplement-evidence.mjs /opt/super-agent/bridge/
COPY plugins/chief-web-pilot/manifest.js \
     plugins/chief-web-pilot/package.json \
     plugins/chief-web-pilot/worker.js /opt/super-agent/plugins/chief-web-pilot/
COPY plugins/chief-web-pilot/ui/index.js /opt/super-agent/plugins/chief-web-pilot/ui/
RUN chmod 0555 /opt/super-agent/entrypoint.sh /opt/super-agent/bin/codex /opt/super-agent/bin/claude
ENV HOME=/paperclip/home NPM_CONFIG_CACHE=/paperclip/npm-cache NODE_ENV=production
ENTRYPOINT ["/usr/bin/tini", "--", "/opt/super-agent/entrypoint.sh"]
CMD ["serve"]
